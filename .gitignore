# --- Terraform ---
# Local state must never be committed (may hold secrets/IDs).
*.tfstate
*.tfstate.*
*.tfstate.backup
# Provider/module cache and crash logs.
.terraform/
crash.log
crash.*.log
# Local var overrides (commit *.tfvars.example instead, if any).
*.tfvars
*.auto.tfvars
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it to pin providers.

# --- Generated by the sandbox / tool ---
# Apply/destroy logs captured during provisioning.
*.log

# --- OS / editor noise ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Node / TypeScript (Chaos Console) ---
node_modules/
dist/
build/
coverage/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# --- Secrets / local runtime config ---
.env
.env.*
!.env.example
# bcrypt hashes — commit users.example.json instead
config/users.json
# demo bcrypt hashes (sandbox creds, reachable only from the operator IP) — never commit
config/sandbox-demo/users.json
*.local.json
# local audit DB
*.db
*.sqlite
*.sqlite3

# --- Build artifacts / snapshots ---
*.zip
# Image hand-off artifacts (docker save tarballs) — too big to commit; rebuild via CI.
dist/
*.tar.gz
